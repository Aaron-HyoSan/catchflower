<?xml version="1.0" encoding="utf-8"?>
<!--
  런처 아이콘 (API 26+ = minSdk이므로 **모든 기기가 이걸 쓴다**).

  🔴 **전경에 배지를 통째로 넣지 않는다.** 납품된 `앱아이콘_시안E`는 이미 원형
     초록 배지인데, 어댑티브 아이콘의 전경은 런처가 **한 번 더 자기 모양대로 깎는다** —
     원형 런처에서는 배지 테두리가 잘리고, 스퀘어 런처에서는 배지 원과 사각 배경이
     이중으로 보인다. 그래서 전경은 **꽃만**, 배경은 배지의 초록 단색이다.

  ⚠️ `mipmap-*/ic_launcher_foreground.png`와 `values/ic_launcher_background.xml`은
     **생성물이다** — 손으로 고치지 말고
     `python3 디자이너_업무/아이콘/_tools/build_android_launcher.py`를 다시 돌린다.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
    <!-- 모노크롬(테마 아이콘, API 33+)은 **주지 않는다.** 시스템이 실루엣으로
         단색화하는데, 이 꽃은 꽃잎 5장과 꽃심의 색 대비로 읽히는 그림이라
         단색이 되면 **덩어리 하나**가 된다. -->
</adaptive-icon>
