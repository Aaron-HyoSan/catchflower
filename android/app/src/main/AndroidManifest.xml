<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- ⚠️ PlantNet·Supabase 호출에 필요하다. **없으면 컴파일은 되고 실행만 죽는다** —
         `HttpURLConnection`이 SecurityException("Permission denied")을 던진다.
         지금까지 Mock 인식기만 돌아서 아무도 눈치채지 못했다. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- 화면 07. 앨범 읽기 권한은 **요청하지 않는다** — 직접 촬영만 등록 가능한 규칙이라
         권한을 안 받는 게 곧 규칙의 보장이다. -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- 촬영 위치 → 장소명·동/구 코드 (지도 14~16 · 지역 랭킹 B-6).
         ⚠️ **선언이 없으면 `checkSelfPermission`이 영구히 DENIED다** — 요청 대화상자가
            아예 뜨지 않는다. 컴파일도 실행도 정상이고 장소만 조용히 안 붙는다.
         ⚠️ FINE도 선언한다. COARSE만 두면 API 31+ 권한 대화상자에 "정확한 위치"
            선택지가 없다. 실제로 필요한 건 동 단위·100m라 COARSE로 충분하지만,
            사용자가 정확한 위치를 고를 수 있어야 장소명 정확도가 올라간다. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <!-- 🔴 **`READ_CONTACTS` 선언을 지웠다**(2026-08-09 · 목표 4).
         화면 19에서 연락처를 읽는 코드를 뗐는데 선언만 남으면, 스토어 목록과 설치
         화면이 **"연락처를 읽는 앱"이라고 말한다** — 읽지도 않는데 그렇게 말하는 것이
         가짜 연락처 목록을 그렸던 것과 같은 종류의 거짓이다.
         ⚠️ 연락처 매칭(전화번호 해시 대조)을 붙일 때 **선언과 코드를 같이** 되살린다.
              선언만 먼저 넣으면 또 이 상태가 된다. -->

    <!-- 카메라 없는 기기(TV 등)에 설치되지 않게. required=false로 두면
         촬영이 앱의 핵심인데 못 쓰는 설치가 생긴다. -->
    <uses-feature
        android:name="android.hardware.camera.any"
        android:required="true" />

    <!-- 🔴 **권한을 선언하면 하드웨어 기능이 `required=true`로 자동으로 붙는다**
         (2026-08-17 실측 · `aapt2 dump badging`):

           uses-implied-feature: android.hardware.camera
               reason='requested android.permission.CAMERA permission'
           uses-implied-feature: android.hardware.location
               reason='requested ACCESS_COARSE_LOCATION, and ACCESS_FINE_LOCATION'

         위에서 일부러 `camera.any`(앞·뒤 아무거나)로 열어 뒀는데, CAMERA 권한이
         **뒷면 카메라(`android.hardware.camera`)를 필수로** 얹어 버렸다. 즉 주석이
         말하는 것과 Play가 거는 조건이 달랐다. 위치도 같은 이유로 필수가 됐는데
         이 앱은 위치가 없어도 돈다(장소명만 안 붙는다 · 화면 03이 그 경우를 안내한다).

         🔴 **증상이 앱 안에 없다.** 빌드·설치·화면 전부 정상이고, 손해는 Play
            **기기 카탈로그에서 조용히 빠지는 기기**로만 나타난다 — 내 폰에서는
            영원히 안 보인다. 그래서 명시적으로 `required=false`를 적어 되돌린다.
         ⚠️ 지우지 마라. 지우면 다시 자동으로 필수가 된다(선언이 없는 것과 같다). -->
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.camera.autofocus"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.location"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.location.gps"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.location.network"
        android:required="false" />

    <!-- 🔴 **`android:icon`이 없으면 런처에 안드로이드 기본 로봇 아이콘이 뜬다.**
         빌드도 실행도 정상이고 앱 안 화면도 멀쩡해서, 앱을 켜서 확인하는 동안에는
         **한 번도 눈에 띄지 않는다** — 홈 화면을 봐야 보인다.
         ⚠️ `roundIcon`도 같이 준다. 어댑티브 아이콘이 있으면 원형 런처가 알아서
            깎지만, `roundIcon`을 비워 두면 일부 런처(픽셀 계열)가 **레거시
            `ic_launcher.png`를 원형으로 다시 깎아** 배지 테두리를 자른다. -->
    <!-- 🔴 **`allowBackup`을 끈다**(기본값은 true다 · 2026-08-16).
         켜져 있으면 안드로이드가 `filesDir`·`SharedPreferences`를 **구글 계정에
         자동 백업**한다. 이 앱에서 그게 위험한 이유는 두 가지다.
         ① 회원 탈퇴([com.catchflower.app.data.LocalDataWiper])가 기기를 다 지워도
            **클라우드 사본은 남는다** — 새 기기에서 복원되면 지운 도감·사진이 돌아온다.
            "탈퇴했는데 사진이 다시 나온다"는 화면에 증상이 없는 종류의 사고다.
         ② 백업에는 Supabase **세션 토큰**이 들어 있다. 다른 기기로 복원되면 같은
            uuid로 두 기기가 붙는다.
         ⚠️ 대가: 기기를 바꾸면 로컬 도감·사진이 안 넘어간다. 그건 서버(`discoveries`)와
            카카오 연결로 복구하는 것이 설계이고, 사진은 애초에 서버에 안 올린다.
         ⚠️ `dataExtractionRules`로 일부만 빼는 방법도 있지만, **새로 추가한 파일이
            기본으로 백업 대상**이 되는 방향이라 반대로 뒤집혀 있다.
    -->
    <!-- 🔴 **평문 HTTP를 막는다.** API 28+는 이미 기본 false지만 **명시한다** —
         네트워크 SDK(카카오맵)나 라이브러리가 `usesCleartextTraffic="true"`를
         매니페스트 병합으로 켜면 우리 선언이 없을 때 **조용히 켜진다**.
         켜졌을 때의 증상은 없다(그냥 어떤 요청이 평문으로 나간다).
         ⚠️ 이 값이 false면 `http://` 호출은 예외로 죽는다. 우리 코드에 `http://`는
            없고(전부 Supabase·PlantNet·카카오 https), 새로 넣을 때 여기서 막힌다. -->
    <application
        android:name=".CatchFlowerApp"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:usesCleartextTraffic="false"
        android:supportsRtl="false"
        android:theme="@style/Theme.CatchFlower">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 카카오 로그인이 끝나고 브라우저가 앱으로 돌아오는 자리.
             🔴 **이 필터가 없으면 카카오 인증은 성공하고 앱은 그대로다** — 브라우저가
                `catchflower://auth-callback`을 열려다 받는 앱을 못 찾는다.
                증상은 "눌러도 안 돼요"이고, 로그에도 아무것도 안 남는다.
             ⚠️ `MainActivity`에 붙이지 않은 이유는 `AuthCallbackActivity` 주석에 있다
                (`singleTask`가 앱 전체 태스크 동작을 바꾼다).
             ⚠️ `noHistory`로 둔다 — 최근 앱 목록에 빈 화면이 남으면 사용자가
                그걸 앱이라고 생각하고 누른다.
             ⚠️ **스킴을 `applicationId`와 같게 두지 않는다.** 겹치면 다른 앱이
                가로챌 수 있고, 안드로이드가 선택 대화상자를 띄운다
                (`SupabaseAuthUrls.APP_REDIRECT` 주석).
             🔴 이 주소는 Supabase 콘솔 **Redirect URLs 허용목록**에도 있어야 한다.
                없으면 서버가 오류 대신 Site URL로 **조용히** 보낸다 — 그러면 이
                필터는 멀쩡한데 인텐트가 아예 오지 않는다. -->
        <activity
            android:name=".AuthCallbackActivity"
            android:exported="true"
            android:noHistory="true"
            android:theme="@android:style/Theme.NoDisplay">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="catchflower" android:host="auth-callback" />
            </intent-filter>
        </activity>
    </application>

</manifest>
