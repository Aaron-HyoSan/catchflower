<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- ⚠️ PlantNet·Supabase 호출에 필요하다. **없으면 컴파일은 되고 실행만 죽는다** —
         `HttpURLConnection`이 SecurityException("Permission denied")을 던진다.
         지금까지 Mock 인식기만 돌아서 아무도 눈치채지 못했다. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- 화면 07. 앨범 읽기 권한은 **요청하지 않는다** — 직접 촬영만 등록 가능한 규칙이라
         권한을 안 받는 게 곧 규칙의 보장이다. -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- 촬영 위치 → 장소명·동/구 코드 (지도 14~16 · 지역 랭킹 B-6).
         ⚠️ **선언이 없으면 `checkSelfPermission`이 영구히 DENIED다** — 요청 대화상자가
            아예 뜨지 않는다. 컴파일도 실행도 정상이고 장소만 조용히 안 붙는다.
         ⚠️ FINE도 선언한다. COARSE만 두면 API 31+ 권한 대화상자에 "정확한 위치"
            선택지가 없다. 실제로 필요한 건 동 단위·100m라 COARSE로 충분하지만,
            사용자가 정확한 위치를 고를 수 있어야 장소명 정확도가 올라간다. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <!-- 화면 19 친구 초대. 화면 03(권한 안내)에서는 **요청하지 않는다** —
         iOS 세션이 같은 결론을 냈다(진행 기록 (16)): 쓰는 화면에서 받아야
         왜 필요한지 설명할 수 있다. 거부하면 초대 링크 단독 화면으로 대체한다. -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />

    <!-- 카메라 없는 기기(TV 등)에 설치되지 않게. required=false로 두면
         촬영이 앱의 핵심인데 못 쓰는 설치가 생긴다. -->
    <uses-feature
        android:name="android.hardware.camera.any"
        android:required="true" />

    <application
        android:name=".CatchFlowerApp"
        android:label="@string/app_name"
        android:supportsRtl="false"
        android:theme="@style/Theme.CatchFlower">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
